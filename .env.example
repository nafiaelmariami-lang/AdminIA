# ─────────────────────────────────────────────────────────────
# AdminIA — variables d'environnement (EXEMPLE, aucune vraie valeur)
# Copier en .env.local (dev) ou configurer chez l'hébergeur (prod).
# Ne JAMAIS commiter de vraies valeurs. Voir docs/03-DEPLOIEMENT.md.
# Vérification complète : npm run doctor
# ─────────────────────────────────────────────────────────────

# URL publique de l'application (liens dans les e-mails, contrôle d'origine CSRF)
APP_URL=http://localhost:3000

# Base de données PostgreSQL.
# Dev sans serveur Postgres : DATABASE_URL=pglite://./.data/pglite (refusé en production)
DATABASE_URL=postgres://adminia:CHANGER_MOI@localhost:5432/adminia

# ── Stockage des documents (toujours chiffrés par l'application) ──
# Clé maîtresse : 32 octets en base64. À SAUVEGARDER hors de l'hébergeur : sans elle, fichiers illisibles.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORAGE_ENCRYPTION_KEY=
# local (un seul serveur) ou s3 (plusieurs instances, recommandé en production)
STORAGE_DRIVER=local
STORAGE_DIR=./.data/files
# Stockage objet compatible S3 (ex. Scaleway https://s3.fr-par.scw.cloud, région fr-par)
S3_ENDPOINT=
S3_REGION=fr-par
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Préfixe facultatif pour séparer les environnements dans un même bucket (ex. production/)
S3_PREFIX=

# ── IA ──
# anthropic (réel) ou mock (démonstration, aucun coût)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Coupe-circuit global de l'IA (true/false)
AI_ENABLED=true
# Protection des coûts (dollars US)
AI_MAX_COST_PER_DOC_USD=0.50
AI_USER_DAILY_BUDGET_USD=2
AI_DAILY_BUDGET_USD=50

# ── E-mails ──
# outbox (fichiers locaux, dev uniquement), brevo (production) ou disabled
EMAIL_DRIVER=outbox
EMAIL_FROM=ne-pas-repondre@adminia.local
EMAIL_FROM_NAME=AdminIA
EMAIL_OUTBOX_DIR=./.data/outbox
BREVO_API_KEY=
# L'analyse IA exige une adresse e-mail confirmée (anti-comptes jetables)
EMAIL_VERIFICATION_REQUIRED=true

# ── Administration (/app/admin) ──
# Adresses des administrateurs, séparées par des virgules. Vide = aucun administrateur.
# Chaque administrateur doit confirmer son adresse ET activer la double authentification.
ADMIN_EMAILS=

# ── Tâches planifiées appelées par HTTP (POST /api/cron/reminders) ──
# Au moins 32 caractères aléatoires. Vide = route désactivée (utiliser alors npm run reminders).
CRON_SECRET=

# ── Paiement Stripe (vide = paiement désactivé, bouton « bientôt disponible ») ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIEL_MONTHLY=
STRIPE_PRICE_ESSENTIEL_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_AUTOMATIC_TAX=false

# Derrière un reverse proxy de confiance (lecture de X-Forwarded-For) : true/false
TRUST_PROXY=false
# Niveau de journalisation : debug, info, warn, error
LOG_LEVEL=info
