# ─────────────────────────────────────────────────────────────
# AdminIA — variables d'environnement (EXEMPLE, aucune vraie valeur)
# Copier en .env.local (dev) ou configurer chez l'hébergeur (prod).
# Ne JAMAIS commiter de vraies valeurs.
# ─────────────────────────────────────────────────────────────

# URL publique de l'application (sert à la vérification d'origine CSRF)
APP_URL=http://localhost:3000

# Base de données PostgreSQL.
# Dev sans serveur Postgres : DATABASE_URL=pglite://./.data/pglite (refusé en production)
DATABASE_URL=postgres://adminia:CHANGER_MOI@localhost:5432/adminia

# Stockage privé des documents (chemin local hors du dossier public)
STORAGE_DIR=./.data/files
# Clé de chiffrement des fichiers : 32 octets encodés en base64.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORAGE_ENCRYPTION_KEY=

# Fournisseur IA : "anthropic" (réel) ou "mock" (démonstration, aucun coût)
AI_PROVIDER=mock
# Clé API Anthropic (uniquement côté serveur, jamais exposée au navigateur)
ANTHROPIC_API_KEY=
# Modèle utilisé pour l'analyse (voir docs/01-ETUDE-MARCHE.md §6 pour les coûts)
AI_MODEL=claude-opus-5-5
# Coupe-circuit global de l'IA (true/false)
AI_ENABLED=true

# ── Protection des coûts (en dollars US) ──
# Plafond de coût estimé pour UNE analyse
AI_MAX_COST_PER_DOC_USD=0.50
# Budget IA quotidien maximal par utilisateur
AI_USER_DAILY_BUDGET_USD=2
# Budget IA quotidien global (toute la plateforme) — au-delà, analyses suspendues
AI_DAILY_BUDGET_USD=50

# Derrière un reverse proxy de confiance (lecture de X-Forwarded-For) : true/false
TRUST_PROXY=false
